import { tool } from 'ai';
import { z } from 'zod';

import { createClient } from '@/lib/supabase/server';

function todayISO() {
  return new Date().toISOString().slice(0, 10);
}

function addDaysISO(days: number) {
  const date = new Date();
  date.setUTCDate(date.getUTCDate() + days);
  return date.toISOString().slice(0, 10);
}

function subtractDaysISO(days: number) {
  const date = new Date();
  date.setUTCDate(date.getUTCDate() - days);
  return date.toISOString().slice(0, 10);
}

export const lionsAiTools = {
  searchContacts: tool({
    description:
      'Search CRM contacts by first name, last name, email, mobile phone, or phone number.',

    inputSchema: z.object({
      query: z
        .string()
        .min(1)
        .max(100)
        .describe('Name, email address, or phone value to search for'),
      status: z
        .enum(['active', 'inactive'])
        .optional()
        .describe('Optional contact status filter'),
    }),

    execute: async ({
      query,
      status,
    }: {
      query: string;
      status?: 'active' | 'inactive';
    }) => {
      const supabase = await createClient();

      const safeQuery = query.trim().replace(/[%(),]/g, '');

      let dbQuery = supabase
        .from('contacts')
        .select(`
          id,
          first_name,
          last_name,
          email,
          mobile_phone,
          phone,
          status,
          do_not_contact,
          contact_tags (
            tag_id,
            tags (
              id,
              name
            )
          ),
          contact_organizations (
            organizations (
              id,
              name
            )
          )
        `)
        .or(
          [
            `first_name.ilike.%${safeQuery}%`,
            `last_name.ilike.%${safeQuery}%`,
            `email.ilike.%${safeQuery}%`,
            `mobile_phone.ilike.%${safeQuery}%`,
            `phone.ilike.%${safeQuery}%`,
          ].join(',')
        )
        .order('last_name')
        .order('first_name')
        .limit(25);

      if (status) {
        dbQuery = dbQuery.eq('status', status);
      }

      const { data, error } = await dbQuery;

      if (error) {
        return {
          success: false,
          error: error.message,
        };
      }

      return {
        success: true,
        count: data?.length ?? 0,
        contacts:
          data?.map((contact: any) => ({
            id: contact.id,
            name: [contact.first_name, contact.last_name]
              .filter(Boolean)
              .join(' '),
            email: contact.email,
            mobilePhone: contact.mobile_phone,
            phone: contact.phone,
            status: contact.status,
            doNotContact: contact.do_not_contact,
            tags:
              contact.contact_tags
                ?.map((relationship: any) => relationship.tags?.name)
                .filter(Boolean) ?? [],
            organizations:
              contact.contact_organizations
                ?.map(
                  (relationship: any) =>
                    relationship.organizations?.name
                )
                .filter(Boolean) ?? [],
          })) ?? [],
      };
    },
  }),

  getMembers: tool({
    description:
      'Get Lions Club memberships, optionally filtered by membership status or dues status.',

    inputSchema: z.object({
      membershipStatus: z
        .enum(['active', 'inactive', 'former', 'deceased'])
        .optional(),
      duesStatus: z
        .enum(['current', 'due', 'overdue', 'waived', 'not_applicable'])
        .optional(),
      limit: z.number().int().min(1).max(100).default(50),
    }),

    execute: async ({
      membershipStatus,
      duesStatus,
      limit,
    }: {
      membershipStatus?: 'active' | 'inactive' | 'former' | 'deceased';
      duesStatus?: 'current' | 'due' | 'overdue' | 'waived' | 'not_applicable';
      limit: number;
    }) => {
      const supabase = await createClient();

      let dbQuery = supabase
        .from('memberships')
        .select(`
          id,
          member_number,
          membership_status,
          membership_type,
          join_date,
          officer_role,
          committee,
          dues_status,
          contacts (
            id,
            first_name,
            last_name,
            email,
            mobile_phone
          )
        `)
        .order('join_date', { ascending: false })
        .limit(limit);

      if (membershipStatus) {
        dbQuery = dbQuery.eq(
          'membership_status',
          membershipStatus
        );
      }

      if (duesStatus) {
        dbQuery = dbQuery.eq(
          'dues_status',
          duesStatus
        );
      }

      const { data, error } = await dbQuery;

      if (error) {
        return {
          success: false,
          error: error.message,
        };
      }

      return {
        success: true,
        count: data?.length ?? 0,
        memberships:
          data?.map((membership: any) => ({
            id: membership.id,
            memberNumber: membership.member_number,
            membershipStatus: membership.membership_status,
            membershipType: membership.membership_type,
            joinDate: membership.join_date,
            officerRole: membership.officer_role,
            committee: membership.committee,
            duesStatus: membership.dues_status,
            contact: membership.contacts
              ? {
                  id: membership.contacts.id,
                  name: [
                    membership.contacts.first_name,
                    membership.contacts.last_name,
                  ]
                    .filter(Boolean)
                    .join(' '),
                  email: membership.contacts.email,
                  mobilePhone: membership.contacts.mobile_phone,
                }
              : null,
          })) ?? [],
      };
    },
  }),

  getUpcomingEvents: tool({
    description:
      'Get upcoming Lions Club events within a specified number of days.',

    inputSchema: z.object({
      days: z
        .number()
        .int()
        .min(1)
        .max(365)
        .default(30)
        .describe('Number of days ahead to search'),
    }),

    execute: async ({ days }: { days: number }) => {
      const supabase = await createClient();

      const startDate = todayISO();
      const endDate = addDaysISO(days);

      const { data, error } = await supabase
        .from('events')
        .select(`
          id,
          name,
          event_type,
          event_date,
          location,
          status,
          event_participants (
            id,
            volunteer_hours
          )
        `)
        .gte('event_date', startDate)
        .lte('event_date', endDate)
        .neq('status', 'cancelled')
        .order('event_date', { ascending: true })
        .limit(100);

      if (error) {
        return {
          success: false,
          error: error.message,
        };
      }

      return {
        success: true,
        range: {
          startDate,
          endDate,
        },
        count: data?.length ?? 0,
        events:
          data?.map((event: any) => ({
            id: event.id,
            name: event.name,
            type: event.event_type,
            date: event.event_date,
            location: event.location,
            status: event.status,
            participantCount:
              event.event_participants?.length ?? 0,
            volunteerHours:
              event.event_participants?.reduce(
                (total: number, participant: any) =>
                  total +
                  Number(participant.volunteer_hours || 0),
                0
              ) ?? 0,
          })) ?? [],
      };
    },
  }),

  searchOrganizations: tool({
    description:
      'Search Lions CRM organizations such as businesses, schools, nonprofits, sponsors, and community organizations.',

    inputSchema: z.object({
      query: z.string().min(1).max(100),
    }),

    execute: async ({ query }: { query: string }) => {
      const supabase = await createClient();

      const safeQuery = query.trim().replace(/[%(),]/g, '');

      const { data, error } = await supabase
        .from('organizations')
        .select(`
          id,
          name,
          organization_type,
          phone,
          website,
          city,
          state,
          contact_organizations (
            id
          )
        `)
        .ilike('name', `%${safeQuery}%`)
        .order('name')
        .limit(25);

      if (error) {
        return {
          success: false,
          error: error.message,
        };
      }

      return {
        success: true,
        count: data?.length ?? 0,
        organizations:
          data?.map((organization: any) => ({
            id: organization.id,
            name: organization.name,
            type: organization.organization_type,
            phone: organization.phone,
            website: organization.website,
            city: organization.city,
            state: organization.state,
            contactCount:
              organization.contact_organizations?.length ?? 0,
          })) ?? [],
      };
    },
  }),

  getRecentDonations: tool({
    description:
      'Get recent Lions Club donations and sponsorships from the CRM.',

    inputSchema: z.object({
      days: z
        .number()
        .int()
        .min(1)
        .max(3650)
        .default(90),
      limit: z
        .number()
        .int()
        .min(1)
        .max(100)
        .default(25),
    }),

    execute: async ({
      days,
      limit,
    }: {
      days: number;
      limit: number;
    }) => {
      const supabase = await createClient();

      const startDate = subtractDaysISO(days);

      const { data, error } = await supabase
        .from('donations')
        .select(`
          id,
          donation_date,
          amount,
          donation_type,
          payment_method,
          anonymous,
          contacts (
            id,
            first_name,
            last_name
          ),
          organizations (
            id,
            name
          ),
          campaigns (
            id,
            name
          )
        `)
        .gte('donation_date', startDate)
        .order('donation_date', {
          ascending: false,
        })
        .limit(limit);

      if (error) {
        return {
          success: false,
          error: error.message,
        };
      }

      const donations =
        data?.map((donation: any) => {
          const contact = donation.contacts;
          const organization = donation.organizations;
          const campaign = donation.campaigns;

          let donor = 'Anonymous';

          if (!donation.anonymous) {
            if (organization?.name) {
              donor = organization.name;
            } else if (contact) {
              donor = [
                contact.first_name,
                contact.last_name,
              ]
                .filter(Boolean)
                .join(' ');
            } else {
              donor = 'Unknown donor';
            }
          }

          return {
            id: donation.id,
            date: donation.donation_date,
            amount: Number(donation.amount || 0),
            type: donation.donation_type,
            paymentMethod: donation.payment_method,
            anonymous: donation.anonymous,
            donor,
            campaign: campaign?.name ?? null,
          };
        }) ?? [];

      return {
        success: true,
        startDate,
        count: donations.length,
        totalAmount: donations.reduce(
          (total: number, donation: any) =>
            total + donation.amount,
          0
        ),
        donations,
      };
    },
  }),

  getCRMOverview: tool({
    description:
      'Get a high-level snapshot of the Lions CRM including contacts, organizations, memberships, events, and recent donations.',

    inputSchema: z.object({}),

    execute: async () => {
      const supabase = await createClient();

      const today = todayISO();
      const ninetyDaysAgo = subtractDaysISO(90);

      const [
        contactsResult,
        organizationsResult,
        activeMembersResult,
        duesDueResult,
        upcomingEventsResult,
        recentDonationsResult,
      ] = await Promise.all([
        supabase
          .from('contacts')
          .select('*', {
            count: 'exact',
            head: true,
          }),

        supabase
          .from('organizations')
          .select('*', {
            count: 'exact',
            head: true,
          }),

        supabase
          .from('memberships')
          .select('*', {
            count: 'exact',
            head: true,
          })
          .eq('membership_status', 'active'),

        supabase
          .from('memberships')
          .select('*', {
            count: 'exact',
            head: true,
          })
          .in('dues_status', ['due', 'overdue']),

        supabase
          .from('events')
          .select('*', {
            count: 'exact',
            head: true,
          })
          .gte('event_date', today)
          .neq('status', 'cancelled'),

        supabase
          .from('donations')
          .select('amount, donation_date')
          .gte('donation_date', ninetyDaysAgo),
      ]);

      const error =
        contactsResult.error ||
        organizationsResult.error ||
        activeMembersResult.error ||
        duesDueResult.error ||
        upcomingEventsResult.error ||
        recentDonationsResult.error;

      if (error) {
        return {
          success: false,
          error: error.message,
        };
      }

      const recentDonations =
        recentDonationsResult.data ?? [];

      return {
        success: true,
        generatedForDate: today,
        contacts: contactsResult.count ?? 0,
        organizations: organizationsResult.count ?? 0,
        activeMembers: activeMembersResult.count ?? 0,
        membershipsWithDuesDue:
          duesDueResult.count ?? 0,
        upcomingEvents:
          upcomingEventsResult.count ?? 0,
        donationsLast90Days: {
          count: recentDonations.length,
          totalAmount: recentDonations.reduce(
            (total, donation) =>
              total + Number(donation.amount || 0),
            0
          ),
        },
      };
    },
  }),
};

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&display=swap');
:root{--navy:#092c5b;--navy2:#103b72;--gold:#f2bd32;--ink:#162a40;--muted:#5d6a77;--paper:#fffefb;--cloud:#f4f6f7;--border:#e2e6ea}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',Arial,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}button{cursor:pointer}h1,h2,h3,p,blockquote{margin-top:0}h1,h2,h3{font-family:Outfit,Arial,sans-serif;letter-spacing:-.036em}h2{font-size:clamp(2.3rem,5vw,4.55rem);line-height:1.06;font-weight:800}p{line-height:1.75}.wrap{max-width:1190px;margin-inline:auto;padding-inline:32px}.section{padding-block:110px}.muted{background:var(--cloud)}.eyebrow{display:inline-block;font-size:.74rem;font-weight:800;letter-spacing:.17em;color:#b07c17;margin-bottom:24px;text-transform:uppercase}.eyebrow.gold{color:var(--gold)}.site-header{height:84px;background:#fff;position:relative;z-index:50;border-bottom:1px solid #edf0f2}.nav-wrap{height:100%;display:flex;justify-content:space-between;align-items:center}.brand{display:flex;align-items:center;gap:13px}.brand-symbol{display:grid;place-items:center;width:47px;height:47px;border:3px solid var(--navy);outline:3px solid var(--gold);outline-offset:-8px;border-radius:50%;font:900 30px Outfit;color:var(--navy)}.brand-copy{display:flex;flex-direction:column;gap:3px}.brand-copy strong{font:800 17px Outfit;letter-spacing:.026em;color:var(--navy)}.brand-copy small{font-size:10px;letter-spacing:.16em;font-weight:800;color:#b38521}.brand-copy small span{color:var(--navy)}.desktop-nav{display:flex;align-items:center;gap:29px}.desktop-nav>a{font-size:13px;font-weight:800}.desktop-nav>a:not(.nav-button):hover{color:#ba8625}.nav-button{display:flex;gap:10px;align-items:center;padding:12px 17px;background:var(--navy);color:#fff;border-radius:3px}.mobile-toggle{display:none;border:0;background:transparent;color:var(--navy)}.mobile-nav{display:none}.hero{position:relative;overflow:hidden;background:radial-gradient(ellipse at 70% 33%,#194c86 0%,#0b3368 38%,#082a59 90%);color:#fff}.hero-grid{position:absolute;inset:0;background-image:linear-gradient(#ffffff08 1px,transparent 1px),linear-gradient(90deg,#ffffff08 1px,transparent 1px);background-size:56px 56px;mask-image:linear-gradient(to right,transparent 28%,black)}.hero-content{position:relative;display:grid;grid-template-columns:1.13fr .87fr;align-items:center;min-height:625px;gap:35px}.hero-text{padding:70px 0 90px;z-index:2}.hero-kicker{display:flex;align-items:center;gap:11px;letter-spacing:.16em;font-weight:800;font-size:11px;color:#f6d77b}.pulse-dot{height:8px;width:8px;background:#f7c43f;border-radius:50%;box-shadow:0 0 0 5px #f7c43f25}.hero h1{font-size:clamp(3.8rem,6.4vw,6.85rem);font-weight:800;line-height:.98;letter-spacing:-.06em;margin:31px 0 27px}.hero h1 em{font-style:normal;color:var(--gold)}.hero p{font-size:17px;line-height:1.9;max-width:530px;color:#e0e9f4}.button-row{display:flex;flex-wrap:wrap;gap:15px;margin-top:33px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:13px;border-radius:4px;padding:16px 24px;font-size:14px;font-weight:800;border:1px solid transparent;transition:transform .15s,background .15s}.btn:hover{transform:translateY(-2px)}.btn-gold{background:var(--gold);color:#132d4c}.btn-gold:hover{background:#ffd35d}.btn-outline-white{border-color:#9eb0c7;color:#fff}.btn-outline-white:hover{background:#ffffff14}.btn-blue{background:var(--navy);color:white}.btn-blue:hover{background:#19518f}.hero-art{position:relative;min-height:510px;display:grid;place-items:center}.hero-art-ring{width:min(430px,100%);aspect-ratio:1;border-radius:50%;border:1px solid #739ac07a;outline:1px solid #7195b65e;outline-offset:22px;display:flex;flex-direction:column;justify-content:space-between;align-items:center;padding:42px 22px;box-shadow:inset 0 0 0 13px #ffffff08,0 0 100px #153c7778;transform:rotate(-8deg)}.hero-art-center{display:flex;flex-direction:column;text-align:center;transform:rotate(8deg)}.hero-art-center span{font:600 58px Outfit;letter-spacing:.05em;line-height:1}.hero-art-center strong{font:900 clamp(60px,7.6vw,105px) Outfit;color:var(--gold);letter-spacing:-.055em;line-height:1}.hero-art-center i{font-size:12px;font-style:normal;letter-spacing:.34em;font-weight:800;margin-top:22px}.round-top,.round-bottom{font-size:11px;letter-spacing:.2em;font-weight:800;color:#c8d9ec}.hero-star{position:absolute;color:var(--gold);font-size:35px}.star-one{left:0;top:19%}.star-two{right:3%;bottom:13%;font-size:23px}.hero-bottom{position:relative;display:flex;justify-content:space-between;align-items:center;padding-bottom:23px;font-size:10px;letter-spacing:.13em;font-weight:800;color:#b3c5de}.hero-bottom-arrow{color:var(--gold)}.intro-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:80px}.intro-grid h2{margin:0}.blue-emphasis{color:#255c97}.intro-copy{padding-top:42px}.intro-copy p,.rich-copy p{font-size:17px;color:#5b6875;margin-bottom:22px}.text-link{display:inline-flex;align-items:center;gap:13px;color:#10457e;font-size:14px;font-weight:800;border-bottom:2px solid var(--gold);padding:5px 0 11px}.text-link.light{color:#fff}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:35px;margin-bottom:40px}.section-heading h2{margin:0}.section-heading>p{max-width:335px;font-size:17px;color:var(--muted)}.pathways{background:#f7f7f4}.pathway-grid,.three-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:21px}.pathway-card{position:relative;display:flex;flex-direction:column;background:#fff;border:1px solid #e2e7eb;padding:33px;min-height:320px;transition:transform .2s,box-shadow .2s}.pathway-card:hover{transform:translateY(-4px);box-shadow:0 18px 45px #123b6114}.pathway-icon{width:58px;height:58px;border-radius:50%;background:#edf3fa;display:grid;place-items:center;color:var(--navy);margin-bottom:40px}.pathway-number{color:#aa7b1c;font-weight:800;font-size:11px;letter-spacing:.12em}.pathway-card h3{font-size:29px;margin:12px 0 10px}.pathway-card p{font-size:15px;color:#66717d;line-height:1.7;max-width:260px}.pathway-arrow{position:absolute;right:28px;top:36px}.mission-block{background:#082b5c;color:white;padding-block:0}.mission-grid{display:grid;grid-template-columns:1fr 1fr;min-height:500px}.mission-visual{background:radial-gradient(circle at center,#1c538b,#0d396c 64%,#0b3060);min-height:500px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}.mission-visual:before,.mission-visual:after{content:'';position:absolute;width:380px;height:380px;border:1px solid #ffffff25;border-radius:50%}.mission-visual:after{width:470px;height:470px}.mission-mark{display:flex;flex-direction:column;z-index:1;text-align:center}.mission-mark span{font:500 55px Outfit;letter-spacing:.16em}.mission-mark strong{font:900 96px Outfit;color:var(--gold);line-height:1}.mission-label{position:absolute;bottom:32px;font-size:10px;letter-spacing:.23em;color:#c2d5e9;font-weight:800}.mission-copy{padding:80px 40px 70px 68px}.mission-copy h2{font-size:clamp(2.6rem,4vw,4rem)}.mission-copy p{color:#d1deec;font-size:16px;line-height:1.9;max-width:500px}.mini-points{display:flex;flex-direction:column;gap:16px;margin:30px 0}.mini-points div{display:flex;align-items:center;gap:16px;font-weight:700;font-size:14px}.mini-points svg{color:var(--gold)}.events-home-card{display:flex;align-items:center;gap:36px;padding:42px;background:#f4f6f9;border-left:5px solid var(--gold)}.event-icon{flex:0 0 96px;height:96px;display:grid;place-items:center;background:#e2eaf3;color:var(--navy);border-radius:50%}.events-home-card h3{font-size:29px;margin:0 0 9px}.events-home-card p{max-width:660px;margin:0;color:var(--muted)}.events-home-card .eyebrow{margin-bottom:10px}.round-arrow{margin-left:auto;display:grid;place-items:center;flex:0 0 55px;height:55px;border-radius:50%;background:var(--navy);color:white}.quote-section{background:var(--gold);padding:65px 0}.quote-grid{display:flex;align-items:center;gap:25px}.quote-grid blockquote{font:800 clamp(1.9rem,3.4vw,3.3rem) Outfit;line-height:1.1;margin:0;flex:1}.quote-grid>span{font-size:11px;letter-spacing:.12em;font-weight:800;max-width:180px}.cta-band{background:#082b59;color:#fff;padding:90px 0}.cta-inner{display:flex;justify-content:space-between;gap:35px;align-items:center}.cta-inner h2{margin-bottom:14px;max-width:680px}.cta-inner p{color:#d1ddeb;max-width:650px}.cta-inner .btn{white-space:nowrap}.footer{background:#051b38;color:#fff;padding:75px 0 25px}.footer-top{display:grid;grid-template-columns:1.2fr .5fr 1fr;gap:60px;padding-bottom:70px}.footer-brand{font:800 28px Outfit}.footer-brand span{color:var(--gold)}.footer p{color:#acc0d9;font-size:14px}.footer-links{display:flex;flex-direction:column;gap:17px;font-size:14px;font-weight:700;color:#d7e2ef}.footer-statement h3{font-size:29px}.footer-social{display:inline-flex;margin-left:20px}.footer-bottom{border-top:1px solid #ffffff26;padding-top:24px;display:flex;justify-content:space-between;gap:20px;font-size:12px;color:#91a9c5}.footer-bottom a{text-decoration:underline}.page-hero{background:#0b3569;color:#fff;padding:108px 0 110px;position:relative;overflow:hidden}.page-hero .wrap{position:relative;z-index:1}.page-hero .eyebrow{color:var(--gold)}.page-hero h1{font-size:clamp(3.5rem,6.8vw,6.3rem);line-height:1.02;max-width:930px;margin-bottom:25px}.page-hero p{font-size:19px;line-height:1.8;max-width:670px;color:#dae4f0;margin-bottom:0}.page-hero-orb{position:absolute;right:-120px;top:-190px;width:650px;height:650px;border-radius:50%;border:100px solid #ffffff0b;box-shadow:0 0 0 90px #ffffff07}.content-grid{display:grid;grid-template-columns:1fr 1fr;gap:90px}.content-grid h2{margin:0}.rich-copy .btn{margin-top:12px}.section-title{max-width:790px;margin-bottom:37px}.value-card,.story-card{background:#fff;border:1px solid var(--border);padding:32px;min-height:230px}.value-card svg{color:#14518b;margin-bottom:28px}.value-card h3,.story-card h3{font-size:26px;margin-bottom:10px}.value-card p,.story-card p{color:var(--muted);font-size:15px}.event-list{display:grid;gap:20px}.event-list-card{display:flex;gap:28px;border:1px solid var(--border);padding:30px}.event-date-box{width:150px;flex-shrink:0;background:#e9f0f7;color:#173b65;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;font-weight:800;text-align:center}.event-list-card h3{font-size:26px;margin-bottom:10px}.event-list-card p{color:var(--muted)}.event-location{display:flex;gap:8px;align-items:center;font-size:13px}.empty-state{border:1px dashed #b5c1ca;background:#fff;padding:64px 30px;text-align:center}.empty-state>svg{color:#1b5188;margin-bottom:19px}.empty-state h3{font-size:28px;margin-bottom:10px}.empty-state p{max-width:540px;margin:0 auto 26px;color:var(--muted)}.form-layout{display:grid;grid-template-columns:.85fr 1.15fr;gap:75px}.form-layout h2{font-size:clamp(2.7rem,4.3vw,4.2rem)}.support-text{color:var(--muted);font-size:17px}.steps{display:grid;gap:23px;margin:37px 0}.steps>div{display:flex;gap:15px;align-items:start}.steps svg{color:#1a5a8b;flex-shrink:0}.steps p{margin:0;color:#61707a}.steps strong{color:var(--ink)}.small-muted{font-size:13px;color:#6d7984}.contact-note{border-top:1px solid var(--border);padding-top:25px;margin-top:34px}.contact-note p{color:var(--muted);margin:7px 0}.inquiry-form{padding:42px;background:#f3f6f8;border:1px solid #e0e6eb;display:flex;flex-direction:column;align-items:stretch}.inquiry-form .eyebrow{margin-bottom:10px}.inquiry-form h3{font-size:31px;margin-bottom:7px}.inquiry-form>p:first-of-type{font-size:13px;color:var(--muted);margin-bottom:25px}.inquiry-form>label:not(.check-row){font-size:13px;font-weight:800;margin:12px 0 8px}.inquiry-form label>span{font-weight:400;color:#697988}.inquiry-form input:not([type=checkbox]),.inquiry-form select,.inquiry-form textarea{width:100%;border:1px solid #cbd5df;border-radius:3px;background:#fff;padding:13px 14px;color:#20374b;font-size:14px}.inquiry-form input:focus,.inquiry-form select:focus,.inquiry-form textarea:focus{outline:2px solid #2d73b2;outline-offset:1px}.inquiry-form textarea{resize:vertical}.check-row{display:flex;align-items:start;gap:11px;margin-top:22px;font-size:13px;color:#435364;line-height:1.5}.check-row input{margin-top:3px;flex-shrink:0}.form-button{margin-top:21px;align-self:flex-start}.form-button:disabled{opacity:.7;cursor:wait}.form-feedback{margin:17px 0 0;padding:13px;font-size:14px}.form-feedback.success{background:#e7f6e9;color:#205c35}.form-feedback.error{background:#ffeded;color:#9e2f2f}.form-privacy{font-size:12px;color:#76828b;margin:23px 0 0}.honeypot{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}
@media(max-width:950px){.desktop-nav{gap:15px}.desktop-nav>a{font-size:12px}.hero-content{grid-template-columns:1.2fr .8fr}.hero-art-ring{width:320px}.hero-art-center strong{font-size:72px}.hero-art-center span{font-size:42px}.intro-grid,.content-grid{gap:40px}.mission-copy{padding:65px 10px 65px 40px}.form-layout{gap:32px}.footer-top{gap:30px}}
@media(max-width:720px){.wrap{padding-inline:22px}.section{padding-block:72px}.site-header{height:75px}.desktop-nav{display:none}.mobile-toggle{display:block}.mobile-nav{display:flex;flex-direction:column;background:#fff;padding:8px 22px 20px;box-shadow:0 16px 20px #0a305019}.mobile-nav a{display:flex;justify-content:space-between;padding:15px 2px;border-bottom:1px solid #e7e9ec;font-weight:700}.hero-content{display:flex;flex-direction:column;gap:0;min-height:0}.hero-text{padding:75px 0 20px}.hero h1{font-size:clamp(3.8rem,12vw,5.7rem)}.hero p{font-size:16px}.hero-art{width:100%;min-height:330px;max-height:360px}.hero-art-ring{width:270px;outline-offset:12px;padding:24px 12px}.hero-art-center strong{font-size:61px}.hero-art-center span{font-size:34px}.hero-art-center i{font-size:8px}.round-top,.round-bottom{font-size:8px}.hero-bottom{padding-top:35px}.hero-bottom>span:first-child{max-width:220px;line-height:1.5}.hero-bottom-arrow{display:none}.intro-grid,.content-grid,.mission-grid,.form-layout{grid-template-columns:1fr;gap:30px}.intro-copy{padding-top:0}.section-heading{display:block}.section-heading>p{margin-top:23px}.pathway-grid,.three-grid{grid-template-columns:1fr}.pathway-card{min-height:265px}.pathway-icon{margin-bottom:25px}.mission-visual{min-height:340px}.mission-visual:before{width:250px;height:250px}.mission-visual:after{width:320px;height:320px}.mission-mark strong{font-size:67px}.mission-copy{padding:45px 0 60px}.mission-grid.wrap{padding:0 22px}.events-home-card{gap:19px;padding:26px 20px;flex-wrap:wrap}.event-icon{flex-basis:60px;height:60px}.event-icon svg{width:28px}.events-home-card>div:nth-child(2){flex:1;min-width:170px}.events-home-card h3{font-size:23px}.events-home-card .round-arrow{display:none}.quote-grid{flex-direction:column;align-items:start}.quote-grid>span{max-width:none}.cta-inner{flex-direction:column;align-items:start}.footer-top{grid-template-columns:1fr;gap:35px}.footer-bottom{flex-direction:column}.page-hero{padding:75px 0 85px}.page-hero h1{font-size:clamp(3rem,10vw,4.8rem)}.page-hero p{font-size:17px}.form-layout{gap:40px}.inquiry-form{padding:27px 20px}.event-list-card{flex-direction:column}.event-date-box{width:100%;min-height:70px;flex-direction:row}.empty-state{padding:45px 22px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important}}
/* V2 editorial design system */
:root{--navy:#0b2b54;--gold:#eebf4f;--ink:#18293b;--paper:#f9f8f4}body{background:var(--paper)}h1,h2,h3{letter-spacing:-.052em}.site-header{background:#fbfaf6!important;border-bottom:1px solid #e5e4dc}.brand-symbol{background:#103b72!important;color:#f2c04b!important}.desktop-nav a:not(.nav-button){font-weight:600}.new-hero{background:#0b2b54;color:#fff;position:relative;min-height:730px;overflow:hidden}.new-hero:before{content:"";position:absolute;inset:0;background:linear-gradient(100deg,#061b37 0%,#0b2b54 48%,#174c77 100%)}.new-hero:after{content:"";position:absolute;right:-14%;bottom:-55%;height:115%;aspect-ratio:1;border:1px solid #ffffff24;border-radius:50%;box-shadow:0 0 0 94px #ffffff05,0 0 0 194px #ffffff04;pointer-events:none}.new-hero-shell{position:relative;z-index:1;min-height:730px;display:flex;flex-direction:column}.new-hero-topline{padding:26px 0;display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid #ffffff2e;color:#c9d4e3;font-size:10px;letter-spacing:.18em;font-weight:700}.new-hero-topline>span{display:flex;align-items:center;gap:10px}.live-dot{display:inline-block;width:8px;height:8px;background:var(--gold);border-radius:100%;box-shadow:0 0 0 5px #eebf4f29}.new-hero-main{flex:1;display:grid;grid-template-columns:1fr 260px;gap:60px;align-items:center;padding:80px 0}.hero-eyebrow,.kicker-light,.kicker-dark{font-weight:800;font-size:11px;letter-spacing:.2em}.hero-eyebrow{color:var(--gold);margin-bottom:25px}.new-hero h1{font-size:clamp(4.9rem,8.5vw,9.1rem);font-weight:800;line-height:.97;margin:0 0 28px}.new-hero h1 em,.new-intro h2 i,.new-paths h2 i,.new-focus h2 i,.new-gather h2 i,.new-faq h2 i,.new-final-cta h2 i{font-style:normal;color:var(--gold)}.hero-heading-group>p{max-width:590px;font-size:17px;line-height:1.75;color:#d4dfed}.new-hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:30px;margin-top:28px}.new-primary-button{display:inline-flex;gap:36px;align-items:center;justify-content:space-between;background:var(--gold);color:#102b49;padding:18px 24px;font-size:13px;font-weight:800;transition:background .2s,transform .2s}.new-primary-button:hover{background:#ffcf65;transform:translateY(-3px)}.new-underline-button{display:inline-flex;align-items:center;gap:15px;font-weight:700;border-bottom:1px solid #a5b8cc;padding:13px 0;font-size:13px}.hero-aside{border-left:1px solid #ffffff4d;padding-left:27px;align-self:end;margin-bottom:50px}.hero-aside>span{font-size:10px;letter-spacing:.18em;color:#c7d5e5}.hero-aside strong{display:block;font-size:clamp(3.7rem,5.2vw,6rem);line-height:.93;letter-spacing:-.07em;margin:20px 0}.hero-aside strong span{color:var(--gold)}.hero-aside p{font-size:13px;color:#c7d5e5}.new-hero-foot{display:flex;justify-content:space-between;align-items:center;gap:20px;border-top:1px solid #ffffff2e;padding:25px 0;color:#c9d4e3;font-weight:700;font-size:10px;letter-spacing:.16em}.new-hero-foot a{display:flex;gap:15px;align-items:center;color:#fff}.new-intro-grid{display:grid;grid-template-columns:110px 1.5fr 1fr;gap:36px;align-items:start}.intro-index{font-size:11px;letter-spacing:.12em;color:#557087;font-weight:800}.kicker-dark{color:#526c83}.new-intro h2{font-size:clamp(2.9rem,5.1vw,5.8rem);margin:23px 0 0}.new-intro h2 i,.new-paths h2 i,.new-gather h2 i,.new-faq h2 i{color:#b88724}.intro-statement{padding-top:36px}.intro-statement p{font-size:17px;color:#526270}.new-text-link{display:inline-flex;align-items:center;gap:16px;font-size:13px;font-weight:800;padding-bottom:9px;border-bottom:2px solid #b88724;margin-top:14px}.new-photo-strip{min-height:360px;display:grid;grid-template-columns:1fr 42%;background:#e3e0d4}.photo-strip-photo{background:linear-gradient(120deg,#27485b9c,#13283b99),repeating-linear-gradient(120deg,#697d80 0 32px,#8fa1a0 32px 55px,#d7cbb2 55px 58px);min-height:360px}.photo-strip-panel{background:#dfbb62;padding:65px 9%;display:flex;flex-direction:column;justify-content:center;color:#172c42}.photo-strip-panel>span{font-size:11px;font-weight:800;letter-spacing:.2em}.photo-strip-panel strong{font-size:clamp(2.2rem,4vw,4.8rem);line-height:1.08;letter-spacing:-.06em;margin:25px 0}.photo-strip-panel small{font-size:11px;line-height:1.5;max-width:250px}.new-paths-top{display:flex;justify-content:space-between;gap:50px;align-items:end}.new-paths-top h2,.focus-heading h2,.gather-side h2,.new-faq h2{margin:15px 0 0}.new-paths-top>p,.focus-heading>p{width:330px;color:#63717f;font-size:16px}.path-selector{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:55px;border-bottom:1px solid #d1d8da}.path-selector button{text-align:left;border:0;border-bottom:3px solid transparent;background:transparent;padding:23px 15px 23px 0;display:flex;align-items:center;gap:15px;color:#647283;font-size:15px;font-weight:800}.path-selector button span{font-size:11px;color:#8a96a0}.path-selector button svg{margin-left:auto}.path-selector button.chosen{color:#123b63;border-bottom-color:#bd8623}.path-detail{background:#0c315d;color:#fff;display:grid;grid-template-columns:1.5fr 1fr;min-height:350px;overflow:hidden}.path-detail>div:first-child{padding:60px}.path-detail h3{font-size:clamp(2.7rem,4.5vw,5rem);margin:12px 0}.path-detail h3 span{color:var(--gold)}.path-detail p{max-width:540px;color:#d2dfed}.new-light-button,.new-light-link{display:inline-flex;align-items:center;gap:20px;color:#f4c656;font-weight:800;font-size:13px;margin-top:12px}.path-detail-pattern{display:flex;align-items:center;justify-content:center;background:repeating-linear-gradient(145deg,transparent 0 40px,#ffffff0a 41px 43px),#154676}.path-detail-pattern span{font-weight:900;font-size:clamp(4rem,7vw,8rem);line-height:.85;letter-spacing:-.09em;color:#ffffff1a}.new-focus{background:#0a2a50;color:#fff}.focus-heading{display:flex;align-items:end;justify-content:space-between;gap:60px}.focus-heading h2{max-width:770px}.focus-heading>p{color:#bbcbdc}.kicker-light{color:#efc05c}.focus-columns{display:grid;grid-template-columns:repeat(3,1fr);margin-top:65px;border-top:1px solid #ffffff34}.focus-columns>div{border-right:1px solid #ffffff34;padding:35px 35px 22px 0;margin-right:35px}.focus-columns>div:last-child{border-right:0;margin-right:0}.focus-number{display:block;letter-spacing:.14em;font-size:10px;color:#c6d5e7;font-weight:700;margin-bottom:44px}.focus-columns svg{color:#eebf4f}.focus-columns h3{font-size:28px;margin:20px 0}.focus-columns p{color:#bdccdc;font-size:15px}.gather-layout{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center}.gather-side h2{font-size:clamp(3rem,5vw,5.4rem)}.gather-side>p{font-size:17px;color:#526270;max-width:500px}.gather-side .new-primary-button{margin-top:20px}.gather-card{background:#fff;border:1px solid #dfdfd8;padding:43px;box-shadow:18px 18px 0 #e8e5db}.gather-card-top{display:flex;gap:15px;align-items:center;border-bottom:1px solid #dde1e3;padding-bottom:30px;margin-bottom:42px;color:#123b63}.gather-card-top span,.gather-label{font-size:11px;font-weight:800;letter-spacing:.15em}.gather-label{color:#b88724}.gather-card h3{font-size:clamp(2rem,3.5vw,3.7rem);line-height:1.06;margin:18px 0}.gather-card p{color:#5c6b78}.gather-card a{display:inline-flex;gap:20px;align-items:center;margin-top:25px;font-weight:800;border-bottom:2px solid #b88724;padding-bottom:10px}.new-faq{background:#f0efe9}.faq-layout{display:grid;grid-template-columns:.75fr 1.25fr;gap:100px}.new-faq h2{font-size:clamp(3.2rem,5.4vw,6rem)}.new-faq>div>div>p{color:#5c6b78}.faq-entry{border-top:1px solid #c8ced0}.faq-entry:last-child{border-bottom:1px solid #c8ced0}.faq-entry button{width:100%;border:0;background:none;display:flex;align-items:center;justify-content:space-between;gap:30px;text-align:left;padding:25px 0;font-weight:800;color:#21384d;font-size:17px}.faq-entry svg{transition:transform .2s;flex-shrink:0}.faq-entry.is-open svg{transform:rotate(180deg)}.faq-entry p{color:#5b6b78;font-size:15px;margin:0;padding:0 35px 27px 0;max-width:650px}.new-final-cta{background:#deb24f;padding:115px 0;text-align:center}.new-final-cta span{display:block;font-weight:800;letter-spacing:.2em;font-size:11px}.new-final-cta h2{font-size:clamp(3rem,6vw,6.7rem);max-width:1000px;margin:26px auto 35px}.new-final-cta h2 i{color:#fff}.new-final-cta .new-primary-button{background:#0a2b51;color:#fff}.new-final-cta .new-primary-button:hover{background:#184a77}
@media(max-width:900px){.new-hero-main{grid-template-columns:1fr}.hero-aside{display:none}.new-intro-grid{grid-template-columns:1fr 1.5fr}.intro-statement{grid-column:2;padding-top:0}.gather-layout,.faq-layout{gap:40px}.focus-heading{align-items:start;flex-direction:column}.focus-heading>p{width:auto}.path-detail-pattern{display:none}.path-detail{grid-template-columns:1fr}}
@media(max-width:720px){.new-hero,.new-hero-shell{min-height:680px}.new-hero-main{padding:70px 0}.new-hero h1{font-size:clamp(3.6rem,12vw,6.5rem)}.new-hero-topline span:nth-child(2){display:none}.new-hero-foot>span{display:none}.new-intro-grid{grid-template-columns:1fr;gap:15px}.intro-statement{grid-column:auto}.new-photo-strip{grid-template-columns:1fr}.photo-strip-photo{min-height:170px}.photo-strip-panel{padding:45px 25px}.new-paths-top{display:block}.new-paths-top>p{width:auto}.path-selector{grid-template-columns:1fr;margin-top:35px}.path-selector button{padding:18px 0}.path-detail>div:first-child{padding:35px 26px}.focus-columns{grid-template-columns:1fr}.focus-columns>div{margin-right:0;border-right:0;border-bottom:1px solid #ffffff34;padding:28px 0}.focus-number{margin-bottom:22px}.gather-layout,.faq-layout{grid-template-columns:1fr;gap:45px}.gather-card{padding:25px;box-shadow:8px 8px 0 #e8e5db}.new-final-cta{padding:80px 0}.new-faq h2{font-size:3.7rem}}
@media(prefers-reduced-motion:reduce){.new-primary-button,.faq-entry svg{transition:none!important}}
/* Liberty Lodge-inspired editorial layout: Lions-specific content and branding. */
:root{--navy:#112844;--gold:#d6b56c;--ink:#142940;--paper:#f7f4ed;--cloud:#ece8dc;--border:#d9d2c1}
body{background:var(--paper);font-family:Arial,Helvetica,sans-serif}h1,h2,h3{font-family:Georgia,'Times New Roman',serif;letter-spacing:-.025em;font-weight:normal}
.site-header{background:#122744!important;border-bottom:1px solid #a58e5a!important;height:88px}.brand-copy strong,.brand-copy small{color:#f7f4ed!important}.brand-copy small{color:#d6b56c!important}.brand-symbol{color:#d6b56c!important;background:transparent!important;border:1.5px solid #d6b56c;outline:0;font-family:Georgia,serif;font-weight:normal}.desktop-nav>a{color:#f8f3e9;font-weight:500}.desktop-nav>a:not(.nav-button):hover{color:#d6b56c}.nav-button{background:#d6b56c;color:#122744!important;border-radius:2px}.mobile-toggle{color:#f7f4ed}
.heritage-hero{position:relative;min-height:710px;background:#122744;overflow:hidden;color:#fff;display:flex;align-items:center;text-align:center}.heritage-hero-glow{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 18%,#254666 0%,#122744 65%,#0a1829 100%)}.heritage-hero-glow:after{content:"";position:absolute;inset:28px;border:1px solid #d6b56c24;pointer-events:none}.heritage-hero-content{position:relative;width:100%;padding-block:85px 90px}.heritage-location{display:flex;justify-content:center;align-items:center;gap:8px;letter-spacing:.25em;font-size:11px;color:#e4c98e;margin-bottom:30px}.heritage-seal{margin:0 auto 30px;height:91px;width:91px;border-radius:50%;border:2px solid #d6b56c;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#ead3a2;box-shadow:0 0 0 7px #d6b56c16}.heritage-seal span{font:normal 43px Georgia,serif;line-height:1}.heritage-seal small{font-size:8px;letter-spacing:.18em}.heritage-overline{font-size:11px;letter-spacing:.28em;color:#d6b56c;margin:0 0 16px}.heritage-hero h1{font-size:clamp(4.2rem,8vw,7.2rem);line-height:1.05;margin-bottom:28px}.heritage-hero h1 em{display:block;font-style:normal;color:#d6b56c}.heritage-rule{width:105px;height:1px;background:#d6b56c;margin:0 auto 29px}.heritage-lead{max-width:630px;margin:0 auto;color:#e1e4e8;font-size:18px;line-height:1.8}.heritage-actions{display:flex;align-items:center;justify-content:center;gap:15px;flex-wrap:wrap;margin-top:36px}.heritage-button,.heritage-outline{min-height:48px;padding:13px 25px;display:inline-flex;align-items:center;justify-content:center;gap:14px;font-size:14px;font-weight:600;border-radius:2px;transition:background .2s,transform .2s}.heritage-button{background:#d6b56c;color:#112844}.heritage-button:hover{background:#efcd81;transform:translateY(-2px)}.heritage-outline{border:1px solid #d6b56c;color:#ead3a2}.heritage-outline:hover{background:#ffffff15}.heritage-section{padding:100px 0}.heritage-reading{max-width:805px;margin-inline:auto;text-align:center;padding-inline:26px}.heritage-eyebrow{font:700 11px Arial,sans-serif;letter-spacing:.22em;color:#92733a;margin-bottom:20px}.heritage-reading h2,.heritage-section-heading h2,.heritage-dark h2,.heritage-invitation h2{font-size:clamp(2.5rem,4.5vw,4.5rem);line-height:1.13;color:#122744;margin:0 0 27px}.heritage-reading>p:not(.heritage-eyebrow){max-width:700px;margin:0 auto 18px;color:#475466;font-size:17px;line-height:1.85}.heritage-inline,.heritage-card a,.heritage-gold-link{display:inline-flex;gap:12px;align-items:center;color:#85662c;border-bottom:1px solid #a08345;font-size:14px;font-weight:600;padding-bottom:7px;margin-top:16px}.heritage-inline:hover,.heritage-card a:hover{color:#122744}.heritage-ways{background:#eee9df}.heritage-section-heading{display:flex;justify-content:space-between;align-items:end;gap:50px;margin-bottom:42px}.heritage-section-heading h2{margin:0}.heritage-section-heading>p{max-width:365px;color:#566272;font-size:16px;margin:0}.heritage-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.heritage-card{background:#fcfbf7;border:1px solid #d9d3c7;padding:37px 30px;display:flex;flex-direction:column;align-items:flex-start;min-height:355px;transition:border-color .2s,transform .2s}.heritage-card:hover{border-color:#b89959;transform:translateY(-3px)}.heritage-card-number{font-size:11px;color:#98804e;letter-spacing:.19em;margin-bottom:24px}.heritage-card>svg{width:33px;height:33px;color:#8f722e;margin-bottom:22px}.heritage-card h3{font-size:30px;line-height:1.12;margin:0 0 13px}.heritage-card p{color:#5e6874;font-size:15px;line-height:1.7}.heritage-card a{margin-top:auto}.heritage-dark{background:#122744;color:#fff;text-align:center;padding:100px 20px}.heritage-dark-inner{max-width:790px}.heritage-dark .heritage-eyebrow{color:#d6b56c}.heritage-dark h2{color:#ead3a2;font-size:clamp(4.5rem,9vw,8rem);margin:12px 0 20px}.heritage-dark p:not(.heritage-eyebrow){max-width:650px;margin:auto;font-size:18px;color:#d2dae5}.heritage-gold-link{color:#e2c488;border-color:#e2c488;margin-top:28px}.heritage-upcoming{background:#f7f4ed}.heritage-event{border-top:2px solid #c5a866;border-bottom:1px solid #d7d0c1;padding:31px 0;display:flex;align-items:center;gap:30px}.heritage-event-icon{width:95px;height:95px;background:#e7e1d3;display:grid;place-items:center;color:#173653;flex:none}.heritage-event>div:nth-child(2){flex:1}.heritage-event-label{font-size:10px;letter-spacing:.17em;font-weight:700;color:#866b33;margin-bottom:10px}.heritage-event h3{font-size:31px;margin:0 0 7px}.heritage-event p:last-child{color:#5c6874;line-height:1.65;margin:0;max-width:700px}.heritage-event>a{color:#173653;border:1px solid #b6a57f;width:52px;height:52px;display:grid;place-items:center;flex:none}.heritage-event>a:hover{background:#e7e1d3}.heritage-invitation{text-align:center;background:#d7b76e;padding:96px 20px}.heritage-invitation .heritage-eyebrow{color:#634a1a}.heritage-invitation h2{margin:12px auto 24px;max-width:1000px}.heritage-invitation p:not(.heritage-eyebrow){font-size:17px;color:#3b4551}.heritage-invitation .heritage-button{background:#122744;color:#fff;margin-top:20px}.heritage-invitation .heritage-button:hover{background:#23466e}.footer{background:#0c1c32}.page-hero{background:#122744}.page-hero h1{font-weight:normal;letter-spacing:-.025em}.btn,.new-primary-button{border-radius:2px}.btn-gold,.new-primary-button{background:#d6b56c;color:#112844}.new-hero,.new-intro,.new-photo-strip,.new-focus,.new-gather,.new-faq,.new-final-cta{display:none}
@media(max-width:800px){.heritage-section{padding:70px 0}.heritage-section-heading{display:block}.heritage-section-heading>p{margin-top:20px}.heritage-cards{grid-template-columns:1fr}.heritage-card{min-height:250px}.heritage-event{align-items:flex-start;gap:15px}.heritage-event-icon{width:65px;height:65px}.heritage-hero{min-height:650px}.heritage-hero h1{font-size:clamp(3.5rem,11vw,6rem)}.heritage-event>a{width:40px;height:40px}}
@media(max-width:600px){.heritage-location{letter-spacing:.13em}.heritage-hero-glow:after{inset:12px}.heritage-event-icon{display:none}.heritage-event h3{font-size:25px}.heritage-section-heading h2,.heritage-reading h2{font-size:2.65rem}.heritage-hero-content{padding-block:68px}}
@media(prefers-reduced-motion:reduce){.heritage-card,.heritage-button{transition:none}}

/* 2026 brand-aligned Port Allegany redesign */
:root{--navy:#0d2240!important;--gold:#ebb700!important;--ink:#0d2240!important;--paper:#fff!important;--cloud:#f4f7fb!important;--border:#e0e6ee!important}body{font-family:Arial,Helvetica,sans-serif!important;background:#fff!important}h1,h2,h3{font-family:Arial,Helvetica,sans-serif!important;font-weight:800!important;letter-spacing:-.045em!important}.site-header{height:88px!important;background:#fff!important;border-bottom:1px solid #e7edf3!important}.brand-symbol{background:none!important;border:0!important;outline:0!important;width:52px;height:52px;font-size:0!important;background-image:url('/images/lions-emblem-official.png')!important;background-size:contain!important;background-repeat:no-repeat!important;background-position:center!important}.brand-copy strong{color:#0d2240!important;font-size:15px!important}.brand-copy small{color:#00338d!important}.desktop-nav>a{color:#0d2240!important;font-weight:700}.desktop-nav .nav-button{background:#ebb700!important;color:#0d2240!important}.mobile-toggle{color:#0d2240!important}.fb-hero{position:relative;min-height:680px;overflow:hidden;background:#0d2240;color:#fff}.fb-hero-photo{position:absolute;inset:0 0 0 42%;background:url('/images/community-hero.jpg') center center/cover no-repeat}.fb-hero-overlay{position:absolute;inset:0;background:linear-gradient(98deg,#071c39 0%,#0b3470 41%,#0b3470cf 52%,#102b5070 74%,#0b224238 100%)}.fb-hero-grid{position:relative;display:grid;grid-template-columns:1.1fr .9fr;align-items:end;min-height:635px}.fb-hero-copy{padding:108px 0 118px;max-width:720px}.fb-kicker{display:flex;align-items:center;gap:10px;letter-spacing:.19em;font-size:11px!important;font-weight:800;color:#f5d35a!important}.fb-dot{width:7px;height:7px;background:#ebb700;border-radius:50%}.fb-kicker-line{height:1px;width:42px;background:#ebb700}.fb-hero h1{font-size:clamp(65px,7.2vw,112px);line-height:.96;margin:30px 0 28px;letter-spacing:-.064em!important}.fb-hero h1 span{color:#ffd139}.fb-hero-sub{max-width:540px;font-size:18px!important;color:#e3eaf3;line-height:1.8}.fb-buttons{display:flex;gap:13px;flex-wrap:wrap;margin-top:34px}.fb-primary,.fb-outline{display:inline-flex;align-items:center;justify-content:center;gap:20px;padding:17px 24px;font-weight:800;font-size:14px;transition:transform .2s,background .2s}.fb-primary{background:#ebb700;color:#0d2240}.fb-outline{border:1px solid #bbc9db;color:white}.fb-primary:hover,.fb-outline:hover{transform:translateY(-3px)}.fb-hero-feature{justify-self:end;margin:0 0 92px 25px;background:#0d2240e8;border-left:4px solid #ebb700;padding:21px 25px;width:260px}.fb-hero-feature span,.fb-hero-feature p{font-size:10px;letter-spacing:.13em;font-weight:800;color:#edc953}.fb-hero-feature h3{font-size:23px;line-height:1.18;margin:10px 0;color:#fff}.fb-hero-feature p{color:#d4e0f0;margin:0}.fb-hero-bottom{position:absolute;bottom:0;left:0;right:0;background:#00338d}.fb-bottom-inner{height:45px;display:flex;justify-content:space-between;align-items:center;color:#fff;font-weight:800;font-size:10px;letter-spacing:.16em}.fb-statement{padding:115px 0}.fb-statement-grid{display:grid;grid-template-columns:1fr 1fr;gap:95px;align-items:center}.fb-overline{color:#00338d;font-weight:900;letter-spacing:.18em;font-size:11px;margin-bottom:23px}.fb-statement h2,.fb-section-top h2,.fb-about-band h2,.fb-event-section h2,.fb-join-banner h2{font-size:clamp(39px,5vw,67px);line-height:1.05;color:#0d2240}.fb-statement h2 span,.fb-section-top h2 span,.fb-about-band h2 span,.fb-event-section h2 span{color:#00338d}.fb-statement-grid>div:last-child p{color:#5e6b7a;font-size:17px;line-height:1.9}.fb-text-link{display:inline-flex;align-items:center;gap:19px;margin-top:15px;font-size:14px;color:#00338d;font-weight:900;border-bottom:3px solid #ebb700;padding-bottom:10px}.fb-photo-mosaic{display:grid;grid-template-columns:1fr 1.2fr 1fr;height:285px;gap:5px;background:#fff}.fb-mosaic-img{position:relative;background-size:cover;background-position:center}.fb-mosaic-one{background-image:url('/images/vision.jpg')}.fb-mosaic-two{background-image:url('/images/main-street.jpg')}.fb-mosaic-three{background-image:url('/images/volunteers.jpg')}.fb-mosaic-img:after{content:'';position:absolute;inset:0;background:linear-gradient(transparent 50%,#061f44b0)}.fb-mosaic-img span{position:absolute;bottom:22px;left:28px;z-index:2;color:#fff;font-weight:900;letter-spacing:.18em;font-size:12px}.fb-serve{background:#f3f7fb;padding:112px 0 95px}.fb-section-top{display:flex;justify-content:space-between;align-items:end;gap:70px;margin-bottom:42px}.fb-section-top>p{max-width:390px;color:#586a7a;font-size:16px}.fb-service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:23px}.fb-service{position:relative;background:white;box-shadow:0 15px 55px #1c3e6b12;transition:transform .2s}.fb-service:hover{transform:translateY(-6px)}.fb-service-photo{height:225px;background-size:cover;background-position:center}.fb-service-icon{position:absolute;top:195px;left:28px;background:#ebb700;color:#0d2240;width:58px;height:58px;display:grid;place-items:center}.fb-service-copy{padding:43px 28px 30px}.fb-service-copy p{font-weight:900;color:#537297;font-size:10px;letter-spacing:.2em}.fb-service-copy h3{font-size:27px;line-height:1.2;color:#0d2240;min-height:66px}.fb-service-copy span{display:inline-flex;align-items:center;gap:12px;font-weight:800;color:#00338d;font-size:13px}.fb-art-note{font-size:11px;color:#6f7e8f;margin:28px 0 0}.fb-about-band{display:grid;grid-template-columns:1fr 1fr;min-height:575px}.fb-about-image{background:url('/images/team.jpg') center/cover no-repeat}.fb-about-content{background:#00338d;color:#fff;padding:95px min(8vw,110px)}.fb-about-content .fb-overline{color:#ffd13e}.fb-about-content h2{color:#fff}.fb-about-content h2 span{color:#ffd13e}.fb-about-content>p:not(.fb-overline){max-width:500px;color:#e1eafa;font-size:17px}.fb-about-content .fb-primary{margin-top:20px}.fb-about-tag{margin-top:55px;border-top:1px solid #ffffff36;padding-top:18px;font-size:11px;letter-spacing:.16em;color:#c2d5ee}.fb-event-section{padding:112px 0;background:#fff}.fb-event-grid{display:grid;grid-template-columns:1fr .8fr;gap:110px;align-items:center}.fb-event-grid>div:first-child>p:not(.fb-overline){color:#5d6b78;max-width:490px;font-size:17px}.fb-event-card{background:#f3f7fb;padding:46px;border-top:5px solid #ebb700}.fb-event-card-top{display:flex;align-items:center;gap:12px;font-weight:900;color:#00338d;font-size:11px;letter-spacing:.16em}.fb-event-card h3{font-size:35px;margin:30px 0 15px}.fb-event-card p{color:#617082}.fb-event-card a{display:inline-flex;align-items:center;gap:13px;font-size:14px;font-weight:800;color:#00338d;margin-top:19px}.fb-join-banner{padding:95px 0;background:#0d2240;color:white;position:relative;overflow:hidden}.fb-join-banner:before{content:'';position:absolute;inset:0;background:linear-gradient(110deg,#0d2240 10%,#00338d 78%)}.fb-join-banner:after{content:'';position:absolute;right:-10%;top:-90%;width:65%;height:230%;transform:rotate(25deg);background:#ffffff08}.fb-join-inner{position:relative;display:flex;align-items:center;justify-content:space-between;gap:65px;z-index:1}.fb-join-banner .fb-overline{color:#ebb700}.fb-join-banner h2{color:white;margin-bottom:20px}.fb-join-banner p:not(.fb-overline){color:#d1ddec}.fb-join-actions{display:flex;align-items:stretch;flex-direction:column;gap:12px;min-width:245px}.fb-facebook{display:inline-flex;gap:13px;padding:16px;border:1px solid #ffffff6d;align-items:center;justify-content:center;font-size:13px;font-weight:800}.footer{background:#091a33!important}.page-hero{background:#00338d!important}.page-hero h1{font-family:Arial,Helvetica,sans-serif!important;font-weight:900!important}.cta-band{background:#00338d!important}.btn-gold{background:#ebb700!important}.eyebrow{color:#00338d}h2,h3{font-family:Arial,Helvetica,sans-serif!important}.footer-brand{font-family:Arial,Helvetica,sans-serif!important}
@media(max-width:950px){.fb-hero-grid{grid-template-columns:1fr}.fb-hero-feature{display:none}.fb-hero-photo{left:25%}.fb-hero-overlay{background:linear-gradient(100deg,#071c39 0%,#0b3470ed 63%,#0b347088 100%)}.fb-hero-copy{padding:95px 0}.fb-statement-grid,.fb-event-grid{gap:45px}.fb-service-grid{gap:12px}.fb-about-content{padding:75px 45px}}@media(max-width:700px){.wrap{padding-inline:22px!important}.fb-hero,.fb-hero-grid{min-height:610px}.fb-hero h1{font-size:clamp(54px,12.5vw,78px)}.fb-hero-copy{padding:85px 0}.fb-hero-sub{font-size:16px!important}.fb-bottom-inner span:last-child{display:none}.fb-statement{padding:75px 0}.fb-statement-grid,.fb-event-grid,.fb-about-band{grid-template-columns:1fr}.fb-section-top{display:block}.fb-section-top>p{max-width:100%}.fb-serve,.fb-event-section{padding:75px 0}.fb-service-grid{grid-template-columns:1fr}.fb-photo-mosaic{height:220px;grid-template-columns:1fr 1fr}.fb-mosaic-three{display:none}.fb-about-image{min-height:300px}.fb-about-content{padding:65px 28px}.fb-join-inner{display:block}.fb-join-actions{margin-top:28px}.fb-hero-bottom{position:absolute}.fb-statement h2,.fb-section-top h2,.fb-about-band h2,.fb-event-section h2,.fb-join-banner h2{font-size:44px}.fb-event-card{padding:27px}}
